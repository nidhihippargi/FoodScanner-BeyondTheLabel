# Open Food Facts API (use staging for development; production only after approval)
OFF_BASE_URL=https://world.openfoodfacts.net
# The documented route is /api/v3/product/{code}. v3.6 is the latest schema family as reviewed 2026-11-12.
OFF_API_VERSION=v3
# Required identifiable header, e.g. FoodScanner-DataEngine/0.1 (project contact URL or email)
OFF_USER_AGENT=
# OFF public staging HTTP Basic Auth values; omit these when using production
OFF_BASIC_AUTH_USER=off
OFF_BASIC_AUTH_PASSWORD=off
OFF_TIMEOUT_MS=8000
OFF_FIELDS=code,product_name,abbreviated_product_name,brands,quantity,product_quantity,ingredients_text,ingredients_text_en,lang,lc,serving_size,nutrition_data_per,nutriments,nutrition,images,image_front_url,image_ingredients_url,image_nutrition_url,last_modified_t,schema_version,product_type

# MongoDB Atlas — only needed for Stage 5 migrations/persistence
MONGODB_URI=
MONGODB_DB_NAME=food_scanner

# USDA FoodData Central API key
FDC_API_KEY=
